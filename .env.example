# Spendly Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
DATABASE_URL=your_database_connection_string_here
# Database pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=5000

# ============================================
# REDIS
# ============================================
# Redis connection string (for cache, sessions, job queue)
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION (JWT)
# ============================================
# Secret key for signing JWTs (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRY=1296000  
JWT_REFRESH_EXPIRY=1296000  
# Invite token expiry (in milliseconds, default 7 days = 604800000)
INVITE_TOKEN_EXPIRY=604800000

# ============================================
# AI & ML SERVICES
# ============================================
# Groq API key for LLM-based receipt processing
GROQ_API_KEY=your_groq_api_key_here
# Groq model for receipt parsing (e.g., mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Groq vision model for OCR on image receipts
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenAI API key (optional fallback)
OPENAI_API_KEY=

# ============================================
# FILE STORAGE
# ============================================
# Private R2 bucket for receipt uploads
S3_BUCKET=spendlyreceipts
S3_REGION=auto
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
# Cloudflare R2 endpoint, for example:
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=your_r2_endpoint_here
# Short-lived signed URLs for viewing receipts directly from R2
RECEIPT_SIGNED_URL_TTL_SECONDS=900
MAX_FILE_SIZE=10485760


# ============================================
# EMAIL (Resend)
# ============================================
# Email provider (resend)
EMAIL_PROVIDER=resend
# Resend API key
RESEND_API_KEY=ryour_resend_api_key_here
# Default sender (use onboarding@resend.dev until your domain is verified)
RESEND_FROM_EMAIL=Spendly <your@resend.mail>
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here

# ============================================
# PAYMENT — CASHFREE
# ============================================
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox                         # 'sandbox' | 'production'
NEXT_PUBLIC_BASE_URL=http://localhost:3000   # production: https://spendly.software

# ============================================
# APP CONFIG
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ROOT_DOMAIN=localhost
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Path-based tenant routing — works on localhost without /etc/hosts changes
# and works in production without wildcard DNS.
# Tenant is identified from the JWT, not the hostname.
TENANT_ROUTING_MODE=path
NEXT_PUBLIC_TENANT_ROUTING_MODE=path

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
SENTRY_DSN=

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000
