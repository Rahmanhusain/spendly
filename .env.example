# Spendly Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/spendly
# Database pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=5000

# ============================================
# REDIS
# ============================================
# Redis connection string (for cache, sessions, job queue)
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION (JWT)
# ============================================
# Secret key for signing JWTs (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=<generate-a-32-byte-secret>
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800
# Invite token expiry (in milliseconds, default 7 days = 604800000)
INVITE_TOKEN_EXPIRY=604800000

# ============================================
# AI & ML SERVICES
# ============================================
# Groq API key for LLM-based receipt processing
GROQ_API_KEY=your_groq_api_key
# Groq model for receipt parsing (e.g., llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
# Optional Groq vision model for OCR on image receipts
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenAI API key (optional fallback)
OPENAI_API_KEY=

# ============================================
# FILE STORAGE
# ============================================
# Private S3-compatible bucket for receipt uploads (R2 recommended)
# Required for receipt uploads and signed access URLs
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
# R2/S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Signed URL lifetime in seconds for direct browser access
RECEIPT_SIGNED_URL_TTL_SECONDS=900
MAX_FILE_SIZE=10485760

# ============================================
# COMPLIANCE (India-specific)
# ============================================
# Company GSTIN (for GST reports and invoices)
GSTIN=
# Company name for GST compliance reports
COMPANY_NAME=
# Company address for GST reports
COMPANY_ADDRESS=

# ============================================
# EMAIL (Resend)
# ============================================
# Email provider (resend)
EMAIL_PROVIDER=resend
# Resend API key
RESEND_API_KEY=your_resend_api_key
# Default sender (use onboarding@resend.dev until your domain is verified)
RESEND_FROM_EMAIL=Spendly <onboarding@resend.dev>

# ============================================
# APP CONFIG
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain used for tenant subdomain routing.
# Local dev: localhost
# Production example: spendly.com
ROOT_DOMAIN=localhost
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
SENTRY_DSN=

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000
